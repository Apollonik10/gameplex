{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server@latest", "start"],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}",
        "SUPABASE_PROJECT_REF": "nznmpfuomfgzmunyhwjb"
      },
      "description": "Supabase MCP — Database operations, Auth, Storage"
    },
    "fetch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "description": "Fetch API — HTTP requests for RAWG, YouTube, and external APIs"
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/data/data/com.termux/files/home/projects/gameplex"],
      "description": "Filesystem — Project file operations"
    }
  },
  "project": {
    "name": "gameplex",
    "root": "/data/data/com.termux/files/home/projects/gameplex",
    "type": "nextjs-pwa"
  }
}
